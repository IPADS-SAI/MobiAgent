{
  "metadata": {
    "name": "basic-gui-task",
    "description": "查看支付宝上的用户账单信息"
  },
  "defaults": {
    "device": "Harmony",
    "use_qwen3": true,
    "use_e2e": true,
    "use_experience": false,
    "accept_planner_changes": false
  },
  "steps": [
    {
      "id": 1,
      "type": "gui_task",
      "task_description": "打开支付宝",
      "on_error": "stop"
    },
    {
      "id": 2,
      "type": "gui_task",
      "task_description": "点击我的，进入账单页面，查看账单信息",
      "on_error": "stop"
    },
    {
      "id": 3,
      "type": "gui_action",
      "action": "screenshot",
      "file_name": "alipay_bill.jpg"
    },
    {
      "id": 4,
      "type": "tool",
      "tool_name": "vlm_qa",
      "inputs": {
        "mode": "summary",
        "image": "${steps.3.output.image_path}",
        "question": "帮我用一段话简要总结当前页面上的支付宝账单信息（不要使用markdown格式，也不要分点，尽量按照账单出现顺序描述每一条记录的类型、对象、金额和时间）"
      }
    }
  ]
}