{
  "metadata": {
    "name": "basic-gui-task",
    "description": "查看饿了么上的用户订单信息"
  },
  "defaults": {
    "device": "Harmony",
    "use_qwen3": true,
    "use_e2e": true,
    "use_experience": false,
    "accept_planner_changes": false
  },
  "steps": [
    {
      "id": 1,
      "type": "gui_task",
      "task_description": "打开饿了么",
      "on_error": "stop"
    },
    {
      "id": 2,
      "type": "gui_task",
      "task_description": "点击“我的”图标，点击我的订单，查看外卖订单",
      "on_error": "stop"
    },
    {
      "id": 3,
      "type": "gui_action",
      "action": "screenshot",
      "file_name": "ele_order.jpg"
    },
    {
      "id": 4,
      "type": "tool",
      "tool_name": "vlm_qa",
      "inputs": {
        "mode": "summary",
        "image": "${steps.3.output.image_path}",
        "question": "帮我用一段话简要总结当前页面上的外卖订单信息（不要使用markdown格式，按照第一单，第二单，第三单的顺序描述，包括点了什么，花了多少钱）"
      }
    }
  ]
}