{
  "metadata": {
    "name": "basic-gui-task",
    "description": "查看腾讯视频上的用户观看记录"
  },
  "defaults": {
    "device": "Harmony",
    "use_qwen3": true,
    "use_e2e": true,
    "use_experience": false,
    "accept_planner_changes": false
  },
  "steps": [
    {
      "id": 1,
      "type": "gui_task",
      "task_description": "打开腾讯视频",
      "on_error": "stop"
    },
    {
      "id": 2,
      "type": "gui_task",
      "task_description": "进入个人中心，点击观看历史，查看观看记录",
      "on_error": "stop"
    },
    {
      "id": 3,
      "type": "gui_action",
      "action": "screenshot",
      "file_name": "tencent_video_history.jpg"
    },
    {
      "id": 4,
      "type": "tool",
      "tool_name": "vlm_qa",
      "inputs": {
        "mode": "summary",
        "image": "${steps.3.output.image_path}",
        "question": "帮我用一段话简要总结当前页面上的腾讯视频观看记录（不要使用markdown格式，也不要分点，尽量按照记录出现顺序描述每个视频的名称、观看进度或更新时间等关键信息）"
      }
    }
  ]
}