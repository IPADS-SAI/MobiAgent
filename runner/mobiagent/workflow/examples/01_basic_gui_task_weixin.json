{
  "metadata": {
    "name": "basic-gui-task",
    "description": "收集指定微信用户近3页的聊天记录"
  },
  "defaults": {
    "device": "Harmony",
    "use_qwen3": true,
    "use_e2e": true,
    "use_experience": false,
    "accept_planner_changes": false
  },
  "context": {
    "contact_name": "小赵"
  },
  "steps": [
    {
      "id": 1,
      "type": "gui_task",
      "task_description": "打开微信",
      "on_error": "stop"
    },
    {
      "id": 2,
      "type": "gui_task",
      "task_description": "搜索${context.contact_name}，进入聊天界面",
      "on_error": "stop"
    },
    {
      "id": 3,
      "type": "loop",
      "times": 3,
      "steps": [
        {
          "id": 1,
          "type": "gui_action",
          "action": "screenshot",
          "file_name": "chat_${loop.index}.jpg"
        },
        {
          "id": 2,
          "type": "tool",
          "tool_name": "vlm_qa",
          "inputs": {
            "mode": "summary",
            "image": "${steps.1.output.image_path}",
            "question": "帮我用一段话简要总结当前界面聊天记录的内容（不要使用markdown格式，也不要分点），这是第${loop.index}次截图。"
          }
        },
        {
          "id": 3,
          "type": "if",
          "condition": {
            "left": "${loop.last}",
            "operator": "==",
            "right": false
          },
          "then_steps": [
            {
              "id": 1,
              "type": "gui_action",
              "action": "swipe_with_coords",
              "start_x": 540,
              "start_y": 800,
              "end_x": 540,
              "end_y": 2100
            },
            {
              "id": 2,
              "type": "gui_action",
              "action": "sleep",
              "seconds": 1.0
            }
          ],
          "else_steps": []
        }
      ]
    }
  ]
}